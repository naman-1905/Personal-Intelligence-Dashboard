# Local-only stack — never point these at cloud hosts
MONGO_URI=mongodb://mongo:27017
MONGO_DB=news_dashboard
REDIS_URL=redis://redis:6379/0
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M
USER_ID=local
API_CORS_ORIGINS=http://localhost:3000,http://web:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
SCRAPE_INTERVAL_HOURS=6
BREAKING_CHECK_MINUTES=60
# Scraper batching for the 600+ source catalog: how many sources each cycle
# fetches (round-robin cursor) and how many items to keep per feed.
SOURCES_PER_CYCLE=30
RSS_ITEMS_PER_SOURCE=10
DIGEST_DEFAULT_HOUR=7
LOG_LEVEL=INFO
