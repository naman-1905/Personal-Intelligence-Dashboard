{
  "name": "news-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted personal news dashboard monorepo (local only)",
  "workspaces": [
    "apps/web",
    "apps/mobile-shell"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "build:web": "npm run build --workspace apps/web",
    "docker:up": "docker compose -f infra/docker-compose.yml --env-file infra/.env up -d --build",
    "docker:down": "docker compose -f infra/docker-compose.yml down",
    "docker:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "docker:ps": "docker compose -f infra/docker-compose.yml ps"
  }
}
